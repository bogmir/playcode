<Components.shell
  root=""
  title={tp("EMOTHE — Catalogue")}
  current={:catalogue}
  site={@site}
  stylesheet="catalogue.css"
>
  <h1>{t("Catalogue")}</h1>
  <p class="intro">
    {t(
      "A repertoire of plays from the five basic traditions of early modern European theatre (Italian, English, French, Portuguese and Spanish), with their translations and adaptations."
    )}
  </p>
  <p class="lede">
    {tn("%{count} play", "%{count} plays", @count)} · {tn(
      "%{count} author",
      "%{count} authors",
      @authors
    )}
  </p>
  <%!-- The box searches the records and the texts at once; the filters are a panel under it.
       Hidden until catalogue.js runs: without it, the page is the full list. --%>
  <div class="find" data-catalogue-controls hidden>
    <div class="box" role="search">
      <label for="c-q" class="sr-only">{t("Search the catalogue")}</label>
      <input
        type="search"
        id="c-q"
        name="q"
        form="search"
        autocomplete="off"
        {ta("placeholder", "Title, author, character or words of the text")}
      />
    </div>
    <div class="tools">
      <fieldset class="seg">
        <legend class="sr-only">{t("Show")}</legend>
        <label>
          <input type="radio" name="sec" value="" form="search" checked /> {t("Everything")}
        </label>
        <label><input type="radio" name="sec" value="o" form="search" /> {t("Plays")}</label>
        <label>
          <input type="radio" name="sec" value="t" form="search" /> {t("Texts and notes")}
        </label>
      </fieldset>
      <button type="button" class="more" aria-expanded="false" aria-controls="search" data-filters>
        {t("Filters")} <span data-active></span>
      </button>
      <label class="sort">
        {t("Sort")}
        <select name="sort" form="search">
          <option value="" {ta("label", "Author")}></option>
          <option value="title" {ta("label", "Title")}></option>
          <option value="date" {ta("label", "Date")}></option>
        </select>
      </label>
    </div>
    <div class="chips" data-chips></div>
    <form
      id="search"
      class="search"
      data-search
      data-words={catalogue_words()}
      data-assets={@site.assets}
      hidden
    >
      <details open>
        <summary>{t("Text and notes")}</summary>
        <fieldset>
          <legend class="sr-only">{t("Match")}</legend>
          <label><input type="radio" name="m" value="" checked /> {t("Starts with")}</label>
          <label><input type="radio" name="m" value="w" /> {t("Exact word")}</label>
        </fieldset>
        <fieldset>
          <legend class="sr-only">{t("Where")}</legend>
          <label><input type="radio" name="in" value="" checked /> {t("Everywhere")}</label>
          <label><input type="radio" name="in" value="s" /> {t("Speeches")}</label>
          <label><input type="radio" name="in" value="d" /> {t("Stage directions")}</label>
          <label><input type="radio" name="in" value="n" /> {t("Notes")}</label>
        </fieldset>
      </details>
      <details open>
        <summary>{t("Play")}</summary>
        <.search_text name="t" label={t("Title")} hint={t("(or code)")} />
        <.search_text name="a" label={t("Author")} suggest />
        <.search_list name="l" label={t("Language")} options={@lists["l"]} />
        <.search_list name="o" label={t("Language of the original")} options={@lists["o"]} />
        <.search_list name="k" label={t("Kind")} options={@lists["k"]} />
        <.search_list name="s" label={t("Collection")} options={@lists["s"]} />
        <.search_list name="f" label={t("Verse or prose")} options={@lists["f"]} />
        <.search_list name="x" label={t("With or without a text")} options={@lists["x"]} />
      </details>
      <details>
        <summary>{t("Dating")}</summary>
        <.search_range
          name="d"
          label={t("Years of composition")}
          from={tp("Dating, from the year")}
          to={tp("Dating, to the year")}
        />
      </details>
      <details>
        <summary>{t("Witnesses")} <small>{t("(all four, of one witness)")}</small></summary>
        <.search_list name="wt" label={t("Support")} options={@lists["wt"]} />
        <.search_text name="wc" label={t("City")} suggest />
        <.search_range
          name="wy"
          label={t("Year")}
          from={tp("Year of the witness, from")}
          to={tp("Year of the witness, to")}
        />
        <.search_list name="wf" label={t("Format")} options={@lists["wf"]} />
      </details>
      <details>
        <summary>
          {t("Performances")} <small>{t("(all six, of one performance)")}</small>
        </summary>
        <.search_text name="rp" label={t("Toponym")} suggest />
        <.search_text name="rv" label={html(tpc("search", "Venue"))} suggest />
        <.search_list name="rc" label={t("Venue type")} options={@lists["rc"]} />
        <.search_range
          name="ry"
          label={t("Date")}
          from={tp("Year of the performance, from")}
          to={tp("Year of the performance, to")}
        />
        <.search_text name="rk" label={t("Company")} suggest />
        <.search_text name="ra" label={t("Cast")} suggest />
      </details>
      <details>
        <summary>{t("Time and place")}</summary>
        <.search_list name="h" label={t("Historical time")} options={@lists["h"]} />
        <.search_text
          name="p"
          label={t("Place of action")}
          hint={t("(«Spain» also finds Seville)")}
          suggest
        />
      </details>
      <details>
        <summary>{t("Characters")}</summary>
        <.search_text name="n" label={t("Character")} />
      </details>
      <button type="reset" class="more">{t("Clear filters")}</button>
    </form>
  </div>
  <p data-count aria-live="polite" class="lede"></p>
  <section data-sect="o">
    <h2 class="sect" hidden></h2>
    <ol class="works" data-works>
      <li
        :for={work <- @works}
        class="work"
        data-work
        data-author={work.sort_author}
        data-title={work.sort_title}
        data-date={work.date}
      >
        <.catalogue_entry play={work.play} lead compare={work.compare} />
        <ul :if={work.translations != []} class="translations">
          <li :for={translation <- work.translations}>
            <.catalogue_entry play={translation} />
          </li>
        </ul>
      </li>
    </ol>
  </section>
  <%!-- catalogue.js copies the list in here for the plays whose text holds the box's words. --%>
  <section data-sect="t" hidden>
    <h2 class="sect"></h2>
  </section>
  <script src={"assets/catalogue.js?v=" <> @site.assets} defer>
  </script>
</Components.shell>
