<Components.shell
  root="../../"
  title={"#{@page.title} — #{@edition.play.title} — EMOTHE"}
  site={@site}
  play={@edition.play}
>
  <:rail><Components.play_rail edition={@edition} current={@page.slug} tools /></:rail>
  <Components.play_header play={@edition.play} />
  <Components.pager prev={@prev} next={@next} />
  <div
    class="text"
    lang={@edition.play.language}
    data-cite={Components.cite_prefix(@edition.play, @page)}
  >
    <Components.outline_item
      :for={item <- if(@page.scene, do: [], else: Edition.before(@edition, @page))}
      edition={@edition}
      item={item}
      head="act-head"
    />
    <Components.page_text edition={@edition} page={@page} />
    <Components.outline_item
      :for={item <- if(@next, do: [], else: @edition.back)}
      edition={@edition}
      item={item}
      head="act-head"
    />
    <Components.endnotes notes={Edition.page_notes(@page)} />
  </div>
  <Components.pager prev={@prev} next={@next} />
</Components.shell>
