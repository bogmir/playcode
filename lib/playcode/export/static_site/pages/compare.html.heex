<Components.shell
  root="../../"
  title={"#{@original.play.title} and #{@translation.play.title} — EMOTHE"}
  site={@site}
  play={[@original.play, @translation.play]}
>
  <div class="compare-bar">
    <a href={"../#{@original.play.code}/index.html"}>Back to {@original.play.title}</a>
    <label>
      Translation
      <select data-compare-menu>
        <option
          :for={{play, label} <- @menu}
          value={"../#{play.code}/compare.html"}
          selected={play.id == @translation.play.id}
        >
          {label}
        </option>
      </select>
    </label>
    <Components.play_tools
      variants={@original.variants or @translation.variants}
      folio={@original.folio or @translation.folio}
      tagged={@original.tagged or @translation.tagged}
      cast={[]}
      shared={Element.shared_lines?(@original.divisions ++ @translation.divisions)}
      stage={Element.stage_directions?(@original.divisions ++ @translation.divisions)}
      steppers={false}
    />
    <noscript>
      <ul class="compare-links">
        <li :for={{play, label} <- @menu}>
          <a href={"../#{play.code}/compare.html"}>{label}</a>
        </li>
      </ul>
    </noscript>
  </div>
  <div class="compare" id="sync-scroll">
    <section
      :for={{edition, n} <- Enum.with_index([@original, @translation])}
      class="panel"
    >
      <header class="panel-head">
        <p class="panel-title">{edition.play.title}</p>
        <p class="meta">{edition.play.author_name} — {edition.play.code}</p>
      </header>
      <div
        class="text"
        data-panel={"panel-#{n}"}
        tabindex="0"
        role="region"
        aria-label={Comparison.panel_name(edition.play, n)}
        lang={edition.play.language}
      >
        <Comparison.text
          edition={edition}
          name={Comparison.panel_name(edition.play, n)}
          prefix={if n == 1, do: "t-"}
        />
      </div>
    </section>
  </div>
  <script>
    <%= Phoenix.HTML.raw(Comparison.script()) %>
  </script>
</Components.shell>
