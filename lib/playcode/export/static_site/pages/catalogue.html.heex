<Components.shell
  root=""
  title={tp("EMOTHE — Catalogue")}
  current={:catalogue}
  site={@site}
  rail_label={t("Filters")}
>
  <:rail>
    <form class="facets" data-facets hidden>
      <fieldset :for={{name, legend, options} <- @facets} class="facet">
        <legend>{legend}</legend>
        <label>
          <input type="radio" name={name} value="" checked /> <span>{t("All")}</span>
          <span class="count">{@count}</span>
        </label>
        <label :for={{value, label, count} <- options}>
          <input type="radio" name={name} value={value} /> <span>{label}</span>
          <span class="count">{count}</span>
        </label>
      </fieldset>
    </form>
  </:rail>
  <h1>{t("Catalogue")}</h1>
  <p class="intro">
    {t(
      "A repertoire of plays from the five basic traditions of early modern European theatre (Italian, English, French, Portuguese and Spanish), with their translations and adaptations."
    )}
  </p>
  <p class="lede">
    {tn("%{count} play", "%{count} plays", @count)} · {tn(
      "%{count} author",
      "%{count} authors",
      @authors
    )}
  </p>
  <div class="controls" data-catalogue-controls hidden>
    <input
      type="search"
      data-filter
      {ta("placeholder", "Filter by title, author or code")}
      {ta("aria-label", "Filter the catalogue")}
    />
    <label>
      {t("Sort")}
      <select data-sort {ta("aria-label", "Sort the catalogue")}>
        <option value="author" {ta("label", "Author")}></option>
        <option value="title" {ta("label", "Title")}></option>
        <option value="date" {ta("label", "Date")}></option>
      </select>
    </label>
  </div>
  <p data-count aria-live="polite" class="lede"></p>
  <ol class="works" data-works>
    <li
      :for={work <- @works}
      class="work"
      data-author={work.sort_author}
      data-title={work.sort_title}
      data-date={work.date}
    >
      <Components.catalogue_entry play={work.play} lead compare={work.compare} />
      <ul :if={work.translations != []} class="translations">
        <li :for={translation <- work.translations}>
          <Components.catalogue_entry play={translation} />
        </li>
      </ul>
    </li>
  </ol>
</Components.shell>
