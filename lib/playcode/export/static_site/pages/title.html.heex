<Components.shell
  root="../../"
  title={"#{@edition.play.title} — EMOTHE"}
  site={@site}
  play={@edition.play}
>
  <:rail><Components.play_rail edition={@edition} current="index" /></:rail>
  <article class="title-page">
    <p class="author">{@edition.play.author_name}</p>
    <h1>{@edition.play.title}</h1>
    <p :if={@edition.play.original_title not in [nil, @edition.play.title]} class="original-title">
      {@edition.play.original_title}
    </p>
    <dl class="facts">
      <dt>Code</dt>
      <dd>{@edition.play.code}</dd>
      <dt>Language</dt>
      <dd>{Play.language_name(@edition.play.language)}</dd>
      <dt>Form</dt>
      <dd>{Components.form_summary(@edition.play, @edition.stats)}</dd>
      <Components.study play={@edition.play} />
    </dl>
    <Components.family play={@edition.play} published={@site.published} />
    <Components.places play={@edition.play} />
    <section :if={@edition.play.editors != []}>
      <h2>Edition</h2>
      <ul>
        <li :for={editor <- @edition.play.editors}>
          {editor.person_name}
          <span class="role">{PlayLabels.editor_role_label(editor.role)}</span>
        </li>
      </ul>
    </section>
    <section :if={@edition.play.sources != []}>
      <h2>Sources</h2>
      <ul>
        <li :for={source <- @edition.play.sources}>
          <Components.inline text={Components.source_text(source)} />
        </li>
      </ul>
    </section>
    <Components.witnesses play={@edition.play} />
    <Components.bibliography groups={@edition.bibliography} />
    <section :for={note <- Components.front_notes(@edition)}>
      <h2>
        <Components.inline text={note.heading || Components.note_heading(note.section_type)} />
      </h2>
      <p :for={paragraph <- Components.paragraphs(note.content)}>
        <Components.inline text={paragraph} />
      </p>
    </section>
    <section :if={Components.cast(@edition.characters) != [] or Components.scene(@edition) != []}>
      <%= if Components.cast(@edition.characters) != [] do %>
        <h2><Components.inline text={Components.cast_heading(@edition.divisions)} /></h2>
        <dl class="cast">
          <%= for character <- Components.cast(@edition.characters) do %>
            <dt><Components.inline text={character.name} /></dt>
            <dd><Components.inline text={character.description} /></dd>
          <% end %>
        </dl>
      <% end %>
      <%= for note <- Components.scene(@edition) do %>
        <h3 :if={note.heading}><Components.inline text={note.heading} /></h3>
        <p :for={paragraph <- Components.paragraphs(note.content)}>
          <Components.inline text={paragraph} />
        </p>
      <% end %>
    </section>
    <section>
      <h2>Contents</h2>
      <Components.play_contents edition={@edition} all_scenes />
    </section>
    <section class="cite">
      <h2>Cite this edition</h2>
      <p data-citation>{Components.citation(@edition.play, @site)}</p>
      <button type="button" class="copy" data-copy-citation hidden>Copy citation</button>
    </section>
    <p :if={Components.licence?(@edition.play)} class="lede">
      <Components.licence play={@edition.play} />
    </p>
    <p><a href={"#{@edition.play.code}.xml"} download>Download the TEI-XML source</a></p>
  </article>
</Components.shell>
