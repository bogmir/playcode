<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <%!-- The search is the catalogue's since 2026-11: an old link's words come along. --%>
    <script>
      location.replace('index.html' + (/[?&]q=([^&]*)/.test(location.search) ? '#q=' + RegExp.$1 : ''))
    </script>
    <meta http-equiv="refresh" content="0; url=index.html" />
    <link rel="canonical" href="index.html" />
    <title>EMOTHE</title>
  </head>
  <body>
    <%!-- No stylesheet here to pick one language: the line in both. --%>
    <p>
      Esta página se ha trasladado / <span lang="en">This page has moved</span>: <a href="index.html">Catálogo / <span lang="en">Catalogue</span></a>.
    </p>
  </body>
</html>
