<Components.shell
  root="../../"
  title={tp("Statistics — %{title} — EMOTHE", title: @edition.play.title)}
  site={@site}
  play={@edition.play}
>
  <:rail><Components.play_rail edition={@edition} current="statistics" /></:rail>
  <Components.play_header play={@edition.play} />
  <h2>{t("Statistics")}</h2>
  <Components.stat_tiles stats={@edition.stats} />
  <Components.synopsis
    :if={(@edition.stats["metrical_passages"] || []) != []}
    passages={@edition.stats["metrical_passages"]}
    range_label={Play.number_label(@edition.play, :range)}
  />
  <Components.character_table
    characters={@edition.stats["characters"] || []}
    unit={if words_unit?(@edition), do: "words", else: "lines"}
    total={
      if words_unit?(@edition), do: @edition.stats["words"] || 0, else: @edition.stats["verses"]
    }
  />
  <Components.presence
    stats={@edition.stats}
    range_label={Play.number_label(@edition.play, :range)}
  />
</Components.shell>
