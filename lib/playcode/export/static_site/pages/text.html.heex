<Components.shell
  root="../../"
  title={"#{@edition.play.title}, full text — EMOTHE"}
  site={@site}
  play={@edition.play}
>
  <:rail><Components.play_rail edition={@edition} current="text" tools /></:rail>
  <Components.play_header play={@edition.play} />
  <div
    class="text"
    lang={@edition.play.language}
    data-cite={Components.cite_prefix(@edition.play, nil)}
  >
    <%= for entry <- @edition.contents do %>
      <%= case entry do %>
        <% {:page, page} -> %>
          <Components.division_text edition={@edition} division={page.division} />
        <% {:item, item} -> %>
          <Components.outline_item edition={@edition} item={item} head="act-head" />
      <% end %>
    <% end %>
    <Components.endnotes notes={
      @edition.pages |> Enum.reject(& &1.scene) |> Enum.map(& &1.division) |> Note.reading_order()
    } />
  </div>
</Components.shell>
