<Components.shell
  root="../../"
  title={tp("%{title}, full text — EMOTHE", title: InlineMarkup.plain(@edition.play.title))}
  site={@site}
  play={@edition.play}
>
  <:rail><Components.play_rail edition={@edition} current="text" tools /></:rail>
  <Components.play_header play={@edition.play} />
  <div
    class="text"
    lang={@edition.play.language}
    data-cite={Components.cite_prefix(@edition.play, nil)}
    data-cite-verse={Play.number_label(@edition.play, :verse)}
    data-cite-prose={Play.number_label(@edition.play, :prose)}
  >
    <Components.full_text edition={@edition} />
  </div>
</Components.shell>
