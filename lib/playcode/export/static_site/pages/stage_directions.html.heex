<Components.shell
  root="../../"
  title={
    tp("Stage directions — %{title} — EMOTHE", title: InlineMarkup.plain(@edition.play.title))
  }
  site={@site}
  play={@edition.play}
>
  <:rail><Components.play_rail edition={@edition} current="stage-directions" /></:rail>
  <Components.play_header play={@edition.play} />
  <h2>{t("Stage directions")}</h2>
  <fieldset
    :if={length(stage_types(@edition)) > 1}
    class="facet note-filter"
    data-note-filter
    hidden
  >
    <legend>{t("Show")}</legend>
    <label><input type="radio" name="stage-type" value="" checked /> {t("All")}</label>
    <label :for={type <- stage_types(@edition)}>
      <input type="radio" name="stage-type" value={type} /> {stage_label(type, t("No kind given"))}
    </label>
  </fieldset>
  <ol class="note-list sd-list" data-notes>
    <li :for={entry <- @edition.stage_directions} data-type={stage_type(entry)}>
      <p class="note-head">
        <b>{stage_label(stage_type(entry), t("Stage direction"))}</b>
        <a href={"#{entry.slug}.html##{entry.anchor}"}>
          {if entry.follows,
            do: t("%{ref}, after %{n}", ref: entry.ref, n: entry.follows),
            else: entry.ref}
        </a>
      </p>
      <p><Components.inline text={entry.text} /></p>
    </li>
  </ol>
</Components.shell>
